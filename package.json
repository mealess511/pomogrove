{
  "name": "pomogrove",
  "private": true,
  "version": "1.1.0",
  "description": "番茄小园 — 把专注种成一座花园。Windows / Android Pomodoro timer.",
  "author": {
    "name": "PomoGrove",
    "email": "hello@pomogrove.app"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "android:assets": "node scripts/make-android-assets.mjs",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:win:setup": "npm run build && electron-builder --win nsis --x64",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/nunito-sans": "^5.2.5",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.52.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "build": {
    "appId": "com.pomogrove.app",
    "productName": "PomoGrove",
    "executableName": "PomoGrove",
    "copyright": "Copyright © 2026 PomoGrove",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PomoGrove-${version}-portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "番茄小园",
      "artifactName": "PomoGrove-${version}-setup.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
